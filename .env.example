# Public Mapbox token (create at https://account.mapbox.com/access-tokens/)
# Copy to .env and set VITE_MAPBOX_ACCESS_TOKEN for local dev.
# On Vercel: Project → Settings → Environment Variables → VITE_MAPBOX_ACCESS_TOKEN
VITE_MAPBOX_ACCESS_TOKEN=

# Optional public HTTPS URL of a backend that permits external API calls,
# without /api/v1. Leave empty on Vercel to use the exported project snapshot.
# Local development also uses the exported snapshot unless this is set.
VITE_API_BASE_URL=
